# Copy to .env and fill in. .env is gitignored and guarded by a pre-commit hook.
# Never commit real credentials (DIRECTIVE.md I5).

# --- database (compose default: service name "db") ---
POSTGRES_USER=quant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quant
DATABASE_URL=postgresql+asyncpg://quant:change-me@localhost:5432/quant

# --- redis ---
REDIS_URL=redis://localhost:6379/0

# --- app ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- frontend ---
# Base URL the *browser* uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- SEC EDGAR (P3.2) ---
# SEC fair-access policy REQUIRES a User-Agent identifying you with contact
# info. The connector refuses to run if this is unset — it will not send an
# anonymous or invented identifier. Format: "Name Surname email@example.com".
SEC_USER_AGENT=

# --- secrets (CC.0, DIRECTIVE §7 / I5) ---
# Fernet key-encryption key: urlsafe-base64-encoded 32 bytes. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sourced from the environment ONLY — never from the database, never committed,
# so a database dump alone cannot decrypt stored provider keys.
SECRETS_KEK=
